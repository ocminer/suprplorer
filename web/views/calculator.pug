extends layout
block content
  - var sym = coin.symbol
  - var def = pools.find(p => p.name === 'Suprnova') || pools[0]
  - var keepOf = (c, p) => 1 - ((p || def).fee + c.fee) / 100
  - var kwh = c => c.power * 24 / 1000
  - var fmtC = v => v >= 100 ? F.num(v, 0) : v >= 1 ? F.num(v, 2) : F.num(v, 3)
  - var rate = v => { var h = F.hashrate(v); return h.value + ' ' + h.unit; }
  - var maxDay = Math.max(1e-12, ...cards.map(c => c.grossPerDay * keepOf(c)))
  - var many = minerReleases.length > 1
  - var tf = c => c.parts.reduce((s, b, k) => s + b * (net[k].growth > 0 ? Math.log1p(net[k].growth * trendDays) / (net[k].growth * trendDays) : 1), 0) * minerReward
  - var pct = g => (g >= 0 ? '+' : '−') + Math.abs(g * 100).toFixed(0) + '%'
  .page-head
    h1 Mining calculator
      span.sub Expected #{sym} per day for each GPU and miner, after the pool's and the miner's fees, from the live network hashrate of each model.
  script#calc-data(type='application/json')!= JSON.stringify(calcData).replace(/</g, '\\u003c')

  form.panel.calc-controls(data-calc='', onsubmit='return false')
    label
      span Pool
      select(name='pool')
        each p, i in pools
          option(value=i, selected=p === def)= p.name + ' (' + p.fee + '%' + (p.verified ? '' : '*') + ')'
    label
      span Electricity
      .input-unit
        input(name='power', type='number', inputmode='decimal', min='0', step='0.01', value=defaultPower.toFixed(2))
        i $/kWh
    label
      span #{sym} price
      .input-unit
        input(name='price', type='number', inputmode='decimal', min='0', step='any', placeholder=price && price.usd ? '' : 'not traded yet', value=price && price.usd ? price.usd : null)
        i $
    label
      span Cards
      .input-unit
        input(name='count', type='number', inputmode='numeric', min='1', max='100000', step='1', value='1')
        i ×
    label(title='The grey figures: average yield over this period if each model\'s network hashrate keeps growing as in the last 24 hours')
      span Network trend
      select(name='trend')
        option(value='1') Next 24 hours
        option(value='7', selected) Next 7 days
        option(value='30') Next 30 days

  .calc-window.section
    span#calc-win-label Network measured over the last
    nav.seg(role='group', aria-labelledby='calc-win-label')
      each w, wi in windows
        button(type='button', data-win=wi, aria-pressed=(wi === defWindow ? 'true' : 'false'))= w.id
    span.dim.calc-win-hint Short windows react fast but swing with luck; long ones are steady but lag a growing network.

  .stats.four.section
    each n, k in net
      - var h = F.hashrate(n.hashrate)
      .stat(data-net=k)
        .stat-label #{n.name} network
        .stat-value
          span(data-f='nv')= h.value
          span.unit(data-f='nu')= h.unit
        .stat-sub
          span(data-f='ns')= F.num(n.blocksPerDay, 0) + ' blocks a day, ' + (n.blockTime ? F.duration(n.blockTime) : '–') + ' each'
          | ; trend #{pct(n.growth)} a day
    +stat('Miner reward', F.num(minerReward, 2), sym, 'Per block: ' + F.num(reward - project, 2) + ' reward after the 5% project share, ' + F.num(feesPerBlock, 4) + ' average fees')
    +stat('Market price', price && price.usd ? '$' + price.usd : '–', null, price && price.usd ? (price.sources || []).join(', ') + ', see Market' : sym + ' is not traded yet. Enter a price to see profit.')

  section.panel.section
    .panel-head
      div
        h2 #{sym} per day by card
        .note.calc-pool-note On #{def.name} (#{def.fee}% pool fee), after each miner's dev fee, network of the last 3 hours
        .calc-key
          span
            i.k-now
            | Today's network
          span
            i.k-trend
            span.calc-trend-label Average of the next #{trendDays} days on the network trend
    ul.hbars.calc-bars
      each c, i in cards
        - var day = c.grossPerDay * keepOf(c)
        - var tday = tf(c) * keepOf(c)
        li(data-i=i)
          span.lbl
            b= c.gpu
            span.dim  #{many ? c.miner + ', ' : ''}#{c.power} W
          span.tracks
            span.track: i(data-f='bar', style='width:' + (maxDay ? (100 * day / maxDay).toFixed(1) : 0) + '%; --c:' + (c.vendor === 'amd' ? '#f07178' : coin.accent))
            span.track.ghost: i(data-f='tbar', style='width:' + (maxDay ? (100 * tday / maxDay).toFixed(1) : 0) + '%')
          span.v
            b(data-f='day')= fmtC(day)
            small(title='Average a day over the chosen period on the network trend') trend #[span(data-f='trend')= fmtC(tday)]

  section.panel.section
    .panel-head
      h2 All cards
      span.aside
        a(href='https://github.com/ocminer/suprplorer/blob/main/CONTRIBUTING.md#add-mining-benchmarks-miner-authors-and-miners', rel='noopener', target='_blank') Add your benchmark ↗
    .table-scroll
      table.t.calc-t
        thead
          tr
            th GPU
            each m in coin.models
              th.num(title='Evaluated attempts per second on ' + m.name + ' blocks')
                i.dot(style='--c:' + m.color)
                |  #{m.name}
            th.num #{sym}/day
            th.num.ghost-h(title='Average a day over the chosen period if the network keeps growing as in the last 24 hours') On trend
            th.num.hide-sm #{sym}/kWh
            th.num Power/day
            th.num(title='Price at which the coins mined pay for the electricity') Break-even
            th.num.calc-profit-h(hidden=!(price && price.usd)) Profit/day
            th.num.hide-sm(title='Average time for one card to find a block alone') Solo, per block
        tbody
          each c, i in cards
            - var day = c.grossPerDay * keepOf(c)
            - var cost = kwh(c) * defaultPower
            tr(data-i=i)
              td
                b= c.gpu
                .dim(style='font-size:12.5px')
                  | #{c.power} W, #{c.miner} #{c.version}, #{c.fee}% fee
                  if c.upcoming
                    span.unverified(title=c.note || 'Not released yet')  (upcoming)
                  else if c.older
                    span.unverified(title=c.note || 'Older release of this miner')  *
                  else if c.note
                    span.unverified(title=c.note)  ⓘ
                  |
                  |
                  a.ext(href=c.source, rel='noopener nofollow ugc', target='_blank', title=(c.upcoming ? c.miner + ' releases (' + c.version + ' not released yet)' : 'Release notes of ' + c.miner + ' ' + c.version) + ', measured ' + c.date) ↗
              each m in coin.models
                td.num= rate(c.rates[m.id])
              td.num: b(data-f='day')= fmtC(day)
              td.num.ghost(data-f='trend')= fmtC(tf(c) * keepOf(c))
              td.num.hide-sm(data-f='kwh')= fmtC(day / kwh(c))
              td.num(data-f='cost')= '$' + F.num(cost, 2)
              td.num(data-f='be')= day > 0 ? '$' + (cost / day).toPrecision(3) : '–'
              td.num(data-f='profit', hidden=!(price && price.usd)) –
              td.num.hide-sm(data-f='solo')= c.blocksPerDay > 0 ? F.duration(86400 / c.blocksPerDay) : '–'
    .table-note
      | Break-even: the #{sym} price at which a day of coins pays a day of electricity.
      if cards.some(c => c.older)
        |  * Older release of that miner; its current version may be faster.
      if cards.some(c => c.note && !c.older && !c.upcoming)
        |  ⓘ How it was measured (hover).
      if cards.some(c => c.upcoming)
        |  Upcoming: measured with a suprminer build that is not released yet.
      |  Rates come from the miners' published benchmarks; on the live network a card's rate moves from block to block, so treat the yield as an estimate.
      if minerReleases.length
        |  Hashrates of
        each r, ri in minerReleases
          | #{ri ? (ri === minerReleases.length - 1 ? ' and' : ',') : ''} #[a(href=r.url || '#', rel='noopener', target='_blank') #{r.miner} #{r.version}]#{r.upcoming ? ' (upcoming)' : ''} (#{r.fee}% fee)
        | .
      if many
        |  Each miner publishes its own measurements, on its own clocks and on the models of the day it measured; a card's rate depends strongly on the model, so differences between miners of less than about 2× are within that spread. The fair comparison is your pool's accepted shares, with each miner run for some hours.

  section.panel.section
    .panel-head
      div
        h2 #{sym} per day by card and pool
        .note After each pool's fee and the miner's own dev fee. Solo mining has no pool fee but pays only when your own rigs find a block.
    .table-scroll
      table.t.matrix-t
        thead
          tr
            th GPU
            each p in pools
              th.num
                if p.color && !p.solo
                  i.dot(style='--c:' + p.color)
                |  #{p.name}
                .dim(style='font-size:12px; font-weight:400') #{p.fee}%#{p.verified ? '' : '*'}
        tbody
          each c, ci in cards
            tr(data-ci=ci)
              td
                b= c.gpu
                if many
                  .dim(style='font-size:12.5px') #{c.miner}, #{c.fee}% fee
              each p, pi in pools
                td.num(data-pool=pi)= fmtC(c.grossPerDay * keepOf(c, p))
    .table-note * No public fee page; the fee was confirmed to us directly. Pools can publish their fee in the labels file on GitHub.

  if trend.lines.length && trend.x.length > 1
    section.panel.chart-card.section
      +chartHead('Yield: last 24 hours and the next ' + trendDays + ' days', null, null, sym + ' per day for one card before fees: solid, at the network of each 2-hour window; dashed, if the network keeps the trend of those 24 hours')
      .panel-body
        +chart('c-trend', trend.x, null, { format: 'coins', unit: sym + '/day', zero: true, lines: trend.lines, tall: true })
      .legend
        each l, li in trend.lines.filter(x => !x.dash)
          span(data-leg=li)
            i.dot(style='--c:' + l.color)
            | #{l.label}
            b(data-f='now')= fmtC(l.now)
            span.dim
              |  → #[span(data-f='end')= fmtC(l.end)] in #{trendDays} days

  section.panel.section
    .panel-head
      h2 How the calculator works
    .panel-body.prose
      p #{coin.name} alternates its models by block height, and a card runs at a very different speed on each, so a single hashrate number would mislead. For every model the calculator takes the network hashrate and the number of blocks a day over the window you choose (3 hours by default: the hashrate climbs fast, so a day average overstates today's yield, while an hour swings with luck), and the card's own rate on that model. The card's expected blocks a day on a model are that model's blocks a day times the card's share of that model's hashrate; the sum over the models, times the miner reward of #{F.num(minerReward, 2)} #{sym}, is the yield.
      p These are expectations: on a pool the payouts follow them closely, solo the time between blocks varies a lot.
      p The network keeps growing, so today's figure only holds for today. The grey figures assume that each model's network hashrate keeps growing in a straight line at the pace of the last 24 hours (now #{net.map(n => n.name + ' ' + pct(n.growth)).join(', ')} of today's hashrate a day) and give the average yield a day over the chosen period: a card's share of the network falls as the network grows. A straight line, not compound growth, and a shrinking network is not assumed, so the grey figure is never above today's. It is a projection of the recent trend, not a forecast of what miners will do.
