extends layout
block content
  - var e = entity(b.miner)
  .page-head
    div
      h1 Block #{F.num(b.height)}
      .title-hash
        span= b.hash
        +copy(b.hash)
    .stepper
      a.btn(href=b.parent ? coin.base + '/block/' + b.parent : '#', aria-disabled=(b.parent ? null : 'true')) Previous
      a.btn(href=b.next ? coin.base + '/block/' + b.next : '#', aria-disabled=(b.next ? null : 'true')) Next
  .stats.four
    +stat('Found by', '', null)
      .stat-value(style='margin-top:6px;font-size:18px')
        if b.height === 0
          span.muted Genesis
        else
          +who(b.miner, { a: 12, b: 6 })
    +stat('Reward', F.amount(b.reward + b.fees, coin.decimals, 2, 4), coin.symbol, 'Fees ' + F.amount(b.fees, coin.decimals, 0) + ' ' + coin.symbol)
    +stat('Transactions', F.num(b.txs), null, F.bytes(b.size))
    +stat('Confirmations', F.num(b.confirmations), null)
      .stat-fin: +finality(b.confirmations)
  section.panel.section
    .panel-head
      h2 Details
    dl.kv
      dt Mined
      dd #{F.utc(b.time)} (#[+age(b.time)])
      dt Difficulty
      dd= F.num(b.difficulty, 4)
      dt Training shares listed
      dd
        = F.num(b.shares)
        if b.shares
          a.dim(href='#shares', style='margin-left:8px') see below
      dt Mined on model
      dd #{(coin.models && coin.models.length) ? coin.models[b.height % coin.models.length].name + ' (slot ' + (b.height % coin.models.length) + ')' : '–'}
      dt Supply after this block
      dd: +amount(b.supply)
      if b.destroyed > 0
        dt Unclaimed reward
        dd: +amount(b.destroyed)
      dt Transfer volume
      dd: +amount(b.volume)
      dt Bits
      dd.mono= b.bits
      dt Nonce
      dd.mono= b.nonce
      dt Body root
      dd.mono= b.bodyRoot
      dt Chain work
      dd.mono= b.chainwork
      if b.parent
        dt Parent
        dd: a.mono(href=coin.base + '/block/' + b.parent)= b.parent
      dt Coinbase data
      dd.mono.dim= b.coinbaseWitness
  section.panel.section
    .panel-head
      h2 Transactions
      span.aside= F.num(b.txs)
    each t in txs
      .txcard
        div
          +hash(t.txid, coin.base + '/tx/' + t.txid, 16, 8)
          if t.coinbase
            span.chip.accent(style='margin-left:10px') Block reward
          each f in flagsOf(t.flags).slice(0, 3)
            span.chip.hide-sm(style='margin-left:6px', title=f.desc)= f.name
          .route(style='margin-top:6px')
            if t.coinbase
              span New coins
            else
              each i in t.inputs.slice(0, 2)
                +who(i.address, { a: 8, b: 4 })
              if t.inputs.length > 2
                span +#{t.inputs.length - 2}
            span.dim →
            each o in t.outputs.slice(0, 3)
              +who(o.address, { a: 8, b: 4 })
            if t.outputs.length > 3
              span +#{t.outputs.length - 3} more
        .num
          +amount(t.totalOut)
          if !t.coinbase
            .dim(style='font-size:12.5px') Fee #{F.amount(t.fee, coin.decimals, 0)}
  if shares && shares.length
    section.panel.section#shares
      .panel-head
        div
          h2 Training shares
          .note Each share is a mined attempt that applies one training step to the #{coin.models && coin.models.length ? coin.models[(b.height - 1 + coin.models.length) % coin.models.length].name : ''} model of the parent round; the block lists #{F.num(b.shares)}#{b.shares > shares.length ? ', ' + shares.length + ' shown' : ''}.
      .table-scroll
        table.t
          thead
            tr
              th #
              th Nonce
              th Body root
              th.num Time
          tbody
            each sh in shares
              tr
                td.rank= sh.idx + 1
                td.mono= sh.nonce
                td.mono.dim= F.short(sh.bodyRoot, 16, 8)
                td.num.dim= F.utc(sh.time)
