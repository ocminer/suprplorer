//- shared building blocks

//- an address: its label as a coloured tag, otherwise the shortened address
mixin who(address, opts)
  - opts = opts || {}
  - var e = address ? entity(address) : null
  if !address
    span.dim –
  else if e
    a.tag(href=coin.base + '/address/' + address, style='--c:' + e.color, title=address)= e.name
  else
    a.mono(href=coin.base + '/address/' + address, title=address)= opts.full ? address : F.short(address, opts.a || 10, opts.b || 6)

//- an amount in base units, fraction digits dimmed
mixin amount(v, opts)
  - opts = opts || {}
  - var p = F.amountParts(v, coin.decimals, opts.min == null ? 2 : opts.min, opts.max || 8)
  span.nowrap(class=opts.cls)
    = (opts.sign && !p.neg ? '+' : '') + (p.neg ? '-' : '') + p.int
    if p.frac
      span.frac= '.' + p.frac
    if !opts.nosym
      span.sym= coin.symbol

mixin hash(h, href, a, b)
  if href
    a.mono(href=href, title=h)= F.short(h, a || 10, b || 8)
  else
    span.mono(title=h)= F.short(h, a || 10, b || 8)

mixin age(ts)
  span.nowrap(data-ts=ts, title=F.utc(ts))= F.ago(ts)

mixin stat(label, value, unit, sub)
  .stat
    .stat-label= label
    if value !== ''
      .stat-value
        = value
        if unit
          span.unit= unit
    if block
      block
    if sub
      .stat-sub!= sub

mixin copy(text)
  button.copy(type='button', data-copy=text, aria-label='Copy to clipboard') Copy

//- a chart: target div + JSON config read by app.js (o.stack = [{label, color, y}] for stacked bars)
mixin chart(id, x, y, o)
  - o = o || {}
  .chart(id=id, class=o.tall ? 'tall' : null)
  script(type='application/json', data-chart='')!= JSON.stringify({ target: id, x: x, y: y, stack: o.stack, step: !!o.step, format: o.format, unit: o.unit, bars: !!o.bars, zero: !!o.zero, color: o.color }).replace(/</g, '\\u003c')

//- chart panel header: title on the left, the latest value large on the right
mixin chartHead(title, value, unit, note)
  .panel-head.chart-head
    div
      h2= title
      if note
        .note= note
    if value != null
      .chart-value
        = value
        if unit
          span.unit= unit

//- donut of segments [{label, value, color, href}]; a null colour is the neutral tile colour
mixin donut(segments, centerValue, centerLabel)
  - var total = segments.reduce(function (s, x) { return s + x.value; }, 0) || 1
  - var acc = 0
  .donut-wrap
    svg.donut(viewBox='0 0 42 42', role='img', aria-label=centerLabel)
      circle(cx='21', cy='21', r='15.915', fill='none', stroke='var(--line-soft)', stroke-width='5')
      each sgm in segments
        - var pct = 100 * sgm.value / total
        - var gap = segments.length > 1 ? Math.min(0.8, pct / 3) : 0
        circle(cx='21', cy='21', r='15.915', fill='none', stroke=sgm.color || 'var(--neutral-tile)', stroke-width='5', stroke-dasharray=(Math.max(0, pct - gap)).toFixed(3) + ' ' + (100 - Math.max(0, pct - gap)).toFixed(3), stroke-dashoffset=(25 - acc).toFixed(3))
          title= sgm.label + ': ' + pct.toFixed(1) + '%'
        - acc += pct
      text.donut-num(x='21', y='21.5', text-anchor='middle')= centerValue
      text.donut-cap(x='21', y='26.5', text-anchor='middle')= centerLabel
    ul.donut-legend
      each sgm in segments
        li
          i.dot(style=sgm.color ? '--c:' + sgm.color : null)
          if sgm.href
            a(href=sgm.href)= sgm.label
          else
            span= sgm.label
          b= (100 * sgm.value / total).toFixed(1) + '%'

mixin chartFoot(values, fmt)
  - var vs = values.filter(function (v) { return v != null; })
  if vs.length
    .chart-foot
      div Low
        b= fmt(Math.min.apply(null, vs))
      div High
        b= fmt(Math.max.apply(null, vs))
      div Latest
        b= fmt(vs[vs.length - 1])

mixin range(current, path)
  nav.seg(aria-label='Time range')
    each r in ['24h', '7d', '30d', 'all']
      a(href=path + '?range=' + r, aria-current=(r === current ? 'true' : null))= r === 'all' ? 'All' : r

mixin pager(pageNo, pages, path)
  if pages > 1
    .pager
      a.btn(href=path + '?page=' + (pageNo - 1), aria-disabled=(pageNo <= 1 ? 'true' : null)) Newer
      span Page #{F.num(pageNo)} of #{F.num(pages)}
      a.btn(href=path + '?page=' + (pageNo + 1), aria-disabled=(pageNo >= pages ? 'true' : null)) Older

mixin searchIcon
  svg(viewBox='0 0 20 20', fill='none', stroke='currentColor', stroke-width='1.8', aria-hidden='true')
    circle(cx='9', cy='9', r='6')
    path(d='M14 14l4 4', stroke-linecap='round')
